# Copy to .env.local and fill in from your Supabase project
# (Project Settings → Data API → Project URL, and API Keys → anon/publishable).
#
# Leave these unset and the site still works: play is free and progress stays in
# the browser. These only switch on cross-device saves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
